# 本文件是示例。仅在 .env 不存在时复制；已有 .env 请在本机编辑，不要覆盖。
# 不要把密钥提交到版本库或粘贴到对话；程序不会打印 MODEL_API_KEY。
APP_TIMEZONE=Asia/Shanghai
APP_MODE=demo
DATABASE_PATH=./data/demo.sqlite
# 按你的服务填写；仓库不预设模型提供方、地址或模型名。
MODEL_PROVIDER=
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_PROTOCOL=chat_completions
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_OUTPUT_TOKENS=1800
# 首次请求只发送 model、messages 和这一输出上限参数。
MODEL_OUTPUT_TOKEN_PARAMETER=max_tokens
MODEL_MAX_RETRIES=1
# 每次 HTTP 尝试都计入预算，包含重试；doctor 与生成各自拥有一次运行预算。
MODEL_MAX_CALLS=6
MODEL_MAX_INPUT_CHARS=24000
# 未提供本服务/模型的真实能力检查记录时，研究默认使用文本 JSON + 校验。
MODEL_RESPONSE_MODE=auto
TUSHARE_TOKEN=
# BaoStock 拟采用的公开查询方式不需要个人 API key。
# 下面的能力默认关闭，完成许可与连通性验证后才启用。
ENABLE_AKSHARE=false
ENABLE_WEB_READER=false
